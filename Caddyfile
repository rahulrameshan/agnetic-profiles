# Caddy fronts everything on one domain.
#
# Two jobs:
#   /api/*  → the FastAPI backend (prefix stripped)
#   /*      → the React bundle, with all unmatched paths falling back to
#             index.html so deep links like /u/rahul survive a refresh
#
# HTTPS certificates are obtained and renewed automatically from Let's Encrypt.
# DOMAIN and ACME_EMAIL come from the .env file next to docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Backend. handle_path strips the /api prefix, so the app keeps serving
	# /auth/login and /u/{username}/chat exactly as it does locally.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Frontend.
	handle {
		root * /srv

		# Hashed CRA assets are immutable; index.html must never be cached or
		# users get a stale bundle pointing at assets that no longer exist.
		@static path /static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-store"

		# Client-side routing: anything that isn't a real file becomes index.html.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
