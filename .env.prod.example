# Copy to .env on the server and fill in. Never commit the real file.
#
#   cp .env.prod.example .env

# The domain you pointed at this server. No scheme, no trailing slash.
DOMAIN=example.com

# Let's Encrypt uses this for expiry warnings.
ACME_EMAIL=you@example.com

# Postgres password. Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs auth tokens. Generate a NEW one for production — do not reuse the dev
# value:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Server-side only. This key is never exposed to the browser.
OPENAI_API_KEY=

# Optional; defaults to 7.
JWT_EXPIRE_DAYS=7
